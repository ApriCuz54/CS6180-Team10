{
  "output_dir": "outputs",
  "provider": "openrouter",
  "api_base_url": "https://openrouter.ai/api/v1",
  "seeds": [42, 123, 456],
  "conditions": ["no_correction", "same_model", "cross_model"],
  "critique_styles": ["targeted", "generic"],
  "max_iterations": 1,
  "model": {
    "generator": "openai/gpt-4o-mini",
    "critic": "openai/gpt-4o",
    "classifier": "openai/gpt-4o-mini"
  },
  "tasks": [
    {
      "name": "math500",
      "data_path": "data/math500_test.jsonl",
      "sample_limit": 250,
      "evaluator_type": "default"
    },
    {
      "name": "hotpotqa",
      "data_path": "data/hotpot_dev_distractor_v1.json",
      "sample_limit": 250,
      "evaluator_type": "default"
    },
    {
      "name": "humaneval",
      "data_path": "data/HumanEval.jsonl",
      "sample_limit": 164,
      "evaluator_type": "default"
    }
  ]
}
